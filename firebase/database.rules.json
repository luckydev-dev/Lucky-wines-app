{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "devices": {
          ".write": "auth != null && auth.uid === $uid && root.child('admins').child($uid).exists()"
        }
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "shopName": {
        ".validate": "newData.isString() && newData.val().length <= 100"
      },
      "isOpen": {
        ".validate": "newData.isBoolean()"
      },
      "deliveryFee": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
      },
      "freeDeliveryAbove": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
      },
      "minOrder": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
      },
      "upiId": {
        ".validate": "newData.isString() && newData.val().length <= 100"
      },
      "upiPayeeName": {
        ".validate": "newData.isString() && newData.val().length <= 100"
      },
      "phone": {
        ".validate": "newData.isString() && newData.val().length <= 30"
      },
      "cutoffTime": {
        ".validate": "newData.isString() && newData.val().length <= 10"
      },
      "minAgeNotice": {
        ".validate": "newData.isString() && newData.val().length <= 500"
      },
      "pincodes": {
        "$i": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        }
      }
    },
    "categories": {
      ".read": true,
      ".indexOn": [
        "order",
        "visible"
      ],
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$categoryId": {
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "order": {
          ".validate": "newData.isNumber()"
        },
        "visible": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "products": {
      ".read": true,
      ".indexOn": [
        "categoryId",
        "featured",
        "visible",
        "price"
      ],
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$productId": {
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "mrp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "stock": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "visible": {
          ".validate": "newData.isBoolean()"
        },
        "featured": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "banners": {
      ".read": true,
      ".indexOn": [
        "order",
        "active"
      ],
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$bannerId": {
        "image": { ".validate": "newData.isString() && newData.val().length <= 600" },
        "title": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "subtitle": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "target": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "order": { ".validate": "newData.isNumber()" },
        "active": { ".validate": "newData.isBoolean()" },
        "startsAt": { ".validate": "newData.isNumber()" },
        "endsAt": { ".validate": "newData.isNumber()" }
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        }
      }
    },
    "orders": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (query.orderByChild == 'userId' && query.equalTo == auth.uid))",
      ".indexOn": [
        "userId",
        "status",
        "createdAt",
        "paymentStatus"
      ],
      "$orderId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (!data.exists() && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'placed' && (newData.child('paymentStatus').val() === 'pending' || newData.child('paymentStatus').val() === 'awaiting_verification')))",
        ".validate": "newData.hasChildren(['id', 'userId', 'userName', 'userPhone', 'items', 'address', 'subtotal', 'deliveryFee', 'total', 'paymentMethod', 'paymentStatus', 'status', 'createdAt', 'updatedAt'])",
        "id": {
          ".validate": "newData.isString() && newData.val() === $orderId"
        },
        "userId": {
          ".validate": "newData.isString()"
        },
        "userName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "userPhone": {
          ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 20"
        },
        "subtotal": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "deliveryFee": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() === newData.parent().child('subtotal').val() + newData.parent().child('deliveryFee').val()"
        },
        "paymentMethod": {
          ".validate": "newData.val() === 'cod' || newData.val() === 'upi'"
        },
        "paymentStatus": {
          ".validate": "newData.val() === 'pending' || newData.val() === 'awaiting_verification' || newData.val() === 'payment_submitted' || newData.val() === 'paid' || newData.val() === 'failed'",
          ".write": "auth != null && data.parent().child('userId').val() === auth.uid && (data.val() === 'awaiting_verification' || data.val() === 'failed') && newData.val() === 'payment_submitted'"
        },
        "status": {
          ".validate": "newData.val() === 'placed' || newData.val() === 'confirmed' || newData.val() === 'packed' || newData.val() === 'out_for_delivery' || newData.val() === 'delivered' || newData.val() === 'cancelled'",
          ".write": "auth != null && data.parent().child('userId').val() === auth.uid && data.val() === 'placed' && newData.val() === 'cancelled'"
        },
        "utr": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{6,30}$/)",
          ".write": "auth != null && data.parent().child('userId').val() === auth.uid && data.parent().child('paymentMethod').val() === 'upi' && (data.parent().child('paymentStatus').val() === 'awaiting_verification' || data.parent().child('paymentStatus').val() === 'failed')"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()",
          ".write": "auth != null && data.parent().child('userId').val() === auth.uid"
        },
        "address": {
          ".validate": "newData.hasChildren(['line1', 'pincode'])",
          "line1": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
          },
          "pincode": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
          }
        },
        "items": {
          "$i": {
            ".validate": "newData.hasChildren(['productId', 'price', 'quantity'])",
            "productId": {
              ".validate": "newData.isString() && root.child('products').child(newData.val()).exists()"
            },
            "price": {
              ".validate": "newData.isNumber() && newData.val() === root.child('products').child(newData.parent().child('productId').val()).child('price').val()"
            },
            "quantity": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50 && newData.val() % 1 === 0"
            }
          }
        }
      }
    },
    "userOrders": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === $uid",
        "$orderId": {
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}
